# Application
APP_NAME=OpenVisionSearch
APP_VERSION=0.1.0
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
API_PREFIX=

# Access control. Leave API_KEY empty to run without authentication.
API_KEY=
CORS_ALLOW_ORIGINS=["*"]

# Storage and engine. The /data paths below are the container paths used by
# docker-compose.yml; use project-relative paths when running uvicorn directly.
APP_DATA_DIR=/data/state
# The legacy /collections API still uses Qdrant. Native becomes the default
# when the /v1 product API lands in Milestone 1.
SEARCH_ENGINE=qdrant
LOG_LEVEL=INFO
LOG_JSON=true

# Vector database, used only when SEARCH_ENGINE=qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
COLLECTION_METADATA_PATH=/data/state/collections.json

# Embedding model. One collection is pinned to one model for its whole life.
DEFAULT_EMBEDDING_PROVIDER=openclip
DEFAULT_MODEL_NAME=ViT-B-32
DEFAULT_MODEL_PRETRAINED=laion2b_s34b_b79k
DEFAULT_VECTOR_SIZE=512
DEFAULT_DISTANCE=cosine
IMAGE_FRAMING=pad
EMBED_VIEWS=1
EMBED_BATCH_SIZE=16
WARMUP_MODEL_ON_STARTUP=true

# ONNX Runtime provider, read only when a collection uses DEFAULT_EMBEDDING_PROVIDER=onnx.
# Build the files with scripts/export_onnx.py. Leave the text encoder unset to
# serve image search only. See "Running without PyTorch" in the README.
ONNX_IMAGE_MODEL_PATH=
ONNX_TEXT_MODEL_PATH=
ONNX_TOKENIZER_PATH=

# Query-side object detection. Off by default. When on, a caller may ask the
# server to find the objects in a photo and search those instead of the whole
# frame. It never touches stored vectors, so switching it on needs no reindex.
# Build the files with scripts/export_detector_onnx.py.
DETECTOR_PROVIDER=none
DETECTOR_MODEL_PATH=
DETECTOR_TOKENIZER_PATH=
# An open-vocabulary detector has no class list, so it must be told what to
# look for. This is the fallback when the caller does not say. Phrase it like a
# caption: "a photo of an object" scores far better than "an object", and a
# caller who names the thing ("a handbag") does better than either.
DETECTOR_PROMPTS=["a photo of an object"]
# Low because generic prompts score low. Raise it if you see phantom regions.
DETECTOR_MIN_SCORE=0.05
# One region is the safe default: folding regions by best score can only
# raise a product's score, so a weak extra region lifts whatever it
# resembles. Raise this for "find everything in this photo" behaviour.
MAX_QUERY_REGIONS=1

# Image sources
ALLOWED_IMAGE_ROOT=/data/images
MAX_IMAGE_SIZE_MB=20
MAX_IMAGE_PIXELS=40000000
MAX_REQUEST_BODY_MB=25
ALLOWED_IMAGE_TYPES=["image/jpeg","image/png","image/webp"]
URL_DOWNLOAD_TIMEOUT_SECONDS=10
MAX_REDIRECTS=3
ALLOW_PRIVATE_URLS=false

# Search limits
DEFAULT_TOP_K=10
MAX_TOP_K=100
# Candidates fetched per query region before duplicates are folded away.
SEARCH_CANDIDATE_MULTIPLIER=4
